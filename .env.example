# Copy to .env.local for development. Keep existing secrets; do not commit them.
BACKEND_URL=http://localhost:4000
# Legacy NEXT_PUBLIC_API_URL remains supported, but browser requests use /api/backend.
# NEXT_PUBLIC_AUTH_URL is unnecessary: the browser uses its current origin.
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated exact additional frontend origins. No wildcards.
# Production aliases belong in Vercel Production settings, not local development.
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters
MONGODB_URI=mongodb://127.0.0.1:27017/studiospace-auth
# Set the same mode and audience on both apps. JWT uses the existing BetterAuth session.
API_AUTH_MODE=jwt
JWT_AUDIENCE=studiospace-api
# Optional: both are required to enable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production: set BACKEND_URL and BETTER_AUTH_URL to your actual deployed HTTPS origins.
# See DEPLOYMENT.md. No secrets belong in NEXT_PUBLIC_ variables.

# Match backend BOOKING_TIME_ZONE; booking times are studio wall-clock times.
NEXT_PUBLIC_BOOKING_TIME_ZONE=Asia/Dhaka
