# Copy to .env.local for development. Keep existing secrets; do not commit them.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
# Optional private override for the API origin (takes priority over NEXT_PUBLIC_API_URL).
BACKEND_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters
MONGODB_URI=mongodb://127.0.0.1:27017/studiospace-auth
# Set the same mode and audience on both apps. JWT uses the existing BetterAuth session.
API_AUTH_MODE=jwt
JWT_AUDIENCE=studiospace-api
# Optional: both are required to enable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
